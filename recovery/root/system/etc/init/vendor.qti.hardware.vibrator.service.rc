on late-fs
    chmod 0666 /dev/richtap_haptic

on boot
    start vendor.qti.vibrator

service vendor.qti.vibrator /system/bin/hw/vendor.qti.hardware.vibrator.service
    user root
    group root
    disabled
    setenv RICHTAP_DEVICE_PATH /dev/richtap_haptic
    setenv ENV_RICHTAP_CONFIG_PATH /system/etc/aac_richtap.config
    seclabel u:r:recovery:s0

on property:sys.boot_completed=1
    setprop vendor.haptic.calibrate.done 1
